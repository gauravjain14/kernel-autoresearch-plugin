# Accumulates into a workspace that is never reset: right on the first call only.
_acc = {}


def kernel_fn(*args):
    out = _ref(*args)
    key = tuple(out.shape)
    if key not in _acc:
        _acc[key] = torch.zeros(out.shape, dtype=torch.float32, device=out.device)
    _acc[key].add_(out.float())
    return _acc[key].to(out.dtype)
